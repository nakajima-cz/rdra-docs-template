#!/usr/bin/env bash
# docs-scaffold: pre-push
#  1) 実装変更に対し docs 未更新を警告（ブロックしない）
#  2) docs/ の構造整合を検査（ERROR があればブロック）
#  3) P01 ゲート検査（4節↔REQ注記。既定では警告のみ）
set -uo pipefail

range="origin/HEAD..HEAD"
git rev-parse --verify -q origin/HEAD >/dev/null 2>&1 || range="HEAD~1..HEAD"

changed=$(git diff --name-only "$range" 2>/dev/null || true)

# 対象ソースディレクトリ（.docs-scaffold/config.sh が無ければ既定値）
DOCS_SOURCE_DIRS="src app lib api server packages"
if [ -f .docs-scaffold/config.sh ]; then
  # shellcheck disable=SC1091
  . .docs-scaffold/config.sh
fi
src_re=$(printf '%s' "$DOCS_SOURCE_DIRS" | tr -s ' ' '|' | sed -E 's/^\|//; s/\|$//')

# --- 1) docs 未更新の警告 ---------------------------------------------------
if [ -n "$changed" ]; then
  # ソース変更（src/, app/, lib/, api/ 等）があるか
  code_changed=""
  if [ -n "$src_re" ]; then
    code_changed=$(echo "$changed" | grep -Ei "^(${src_re})/" || true)
  fi
  docs_changed=$(echo "$changed" | grep -E '^docs/' || true)

  if [ -n "$code_changed" ] && [ -z "$docs_changed" ]; then
    echo "──────────────────────────────────────────────"
    echo "docs-scaffold WARNING: コード変更に対し docs/ が未更新です"
    echo "  対象ソース: ${DOCS_SOURCE_DIRS}"
    echo "  SCR-/API-/traceability の該当設計書を確認してください"
    echo "  自動同期: bash scripts/docs-sync/sync-docs.sh（エージェントは .docs-scaffold/config.sh の DOCS_SYNC_AGENT）"
    echo "  （このpushはブロックしていません）"
    echo "──────────────────────────────────────────────"
  fi
fi

# --- python 解決 -------------------------------------------------------------
# command -v だけでは、実行不能な asdf / pyenv シムを判別できない。
resolve_python() {
  local cand found=0
  for cand in python3 /usr/bin/python3 /opt/homebrew/bin/python3 python; do
    if command -v "$cand" >/dev/null 2>&1; then
      found=1
      if "$cand" -c 'pass' >/dev/null 2>&1; then
        printf '%s' "$cand"
        return 0
      fi
    fi
  done
  if [ "$found" -eq 1 ]; then
    return 2
  fi
  return 1
}

python_bin=""
if [ -d docs ]; then
  if python_bin=$(resolve_python); then
    :
  else
    python_status=$?
    if [ "$python_status" -eq 1 ]; then
      echo "docs-validate: python3 未検出のため検査をスキップしました"
    else
      echo "docs-validate: python3 は見つかりましたが実行できないため検査をスキップしました"
    fi
    python_bin=""
  fi
fi

exit_code=0

# --- 2) docs 構造整合の検査 -------------------------------------------------
# ERROR = 構造の破綻（ID の dangling / 対応表の不一致 / frontmatter 欠落）→ ブロック
# WARN  = 埋め忘れ（プレースホルダ / 画像リンク切れ）→ 表示のみ
# 回避: DOCS_VALIDATE_SOFT=1 git push  または  git push --no-verify
validator="scripts/docs-validate/validate-docs.py"
if [ -n "$python_bin" ] && [ -f "$validator" ] && [ -d docs ]; then
  echo "docs-validate: docs/ の構造を検査します..."
  if ! "$python_bin" "$validator"; then
    if [ "${DOCS_VALIDATE_SOFT:-0}" = "1" ]; then
      echo "docs-validate: ERROR がありますが DOCS_VALIDATE_SOFT=1 のため push を継続します"
    else
      echo "──────────────────────────────────────────────"
      echo "docs-validate: ERROR のため push を中止しました"
      echo "  修正するか、DOCS_VALIDATE_SOFT=1 git push で一時的に回避できます"
      echo "──────────────────────────────────────────────"
      exit_code=1
    fi
  fi
fi

# --- 3) P01 ゲート検査（4節↔REQ注記） ---------------------------------------
# docs/p00-brief.md「4. 確定していること」の各行に（REQ-xxx）か
# （要求ではない: 理由）が付いているかを検査する。
# 既存プロジェクトには、この検査を導入する前から注記の無い行が大量に残っている
# 可能性があるため、既定では警告のみで push をブロックしない。
# チームで注記の運用が定着したら DOCS_P01_GATE_STRICT=1 でブロックへ格上げできる。
gate_checker="scripts/docs-validate/check-p01-gates.py"
if [ -n "$python_bin" ] && [ -f "$gate_checker" ] && [ -f docs/p00-brief.md ]; then
  gate_output=$("$python_bin" "$gate_checker" 2>&1)
  gate_rc=$?
  if [ "$gate_rc" -ne 0 ]; then
    echo "──────────────────────────────────────────────"
    echo "$gate_output"
    if [ "${DOCS_P01_GATE_STRICT:-0}" = "1" ]; then
      echo "docs-validate: check-p01-gates の ERROR のため push を中止しました (DOCS_P01_GATE_STRICT=1)"
      exit_code=1
    else
      echo "docs-validate: check-p01-gates WARNING（このpushはブロックしていません。DOCS_P01_GATE_STRICT=1 で必須化できます）"
    fi
    echo "──────────────────────────────────────────────"
  fi
fi

exit "$exit_code"
