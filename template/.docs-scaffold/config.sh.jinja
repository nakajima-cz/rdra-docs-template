# docs-scaffold: 共通設定
#
# このファイルは copier の source_dirs 回答から生成される。後から手で編集してよい
# （_skip_if_exists で保護されているので copier update では上書きされない）。
#
# DOCS_SOURCE_DIRS: 実装ソースのディレクトリ（スペース区切り、リポジトリルートからの相対）
#   - .githooks/pre-push: ここが変わったのに docs/ が未更新なら警告
#   - scripts/docs-sync/sync-docs.sh: ここの差分だけを docs 同期の入力にする
# 例) Go: "cmd internal pkg" / monorepo: "apps packages" / Rails: "app lib"
DOCS_SOURCE_DIRS="{{ source_dirs }}"

# DOCS_SYNC_AGENT: docs 同期に使うコーディングエージェント
#   claude / codex / opencode / custom / none
#   none = 自動同期せず、手動更新を促すだけ
DOCS_SYNC_AGENT="{{ docs_sync_agent }}"

# DOCS_SYNC_CMD: DOCS_SYNC_AGENT=custom のときに実行するコマンド。
# プロンプトが最後の引数として渡される（例: "my-agent run --quiet"）。
DOCS_SYNC_CMD="{{ docs_sync_cmd }}"
